<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_home_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_padding_horizontal"
    android:paddingTop="@dimen/tv_screen_padding_vertical"
    android:paddingEnd="@dimen/tv_screen_padding_horizontal"
    android:paddingBottom="@dimen/tv_screen_padding_vertical">

    <TextView
        android:id="@+id/import_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_import_title"
        android:textColor="@color/material_light_blue_50"
        android:textSize="@dimen/tv_home_title_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tv_home_gap"
        android:layout_weight="1"
        android:background="@drawable/tv_panel_background"
        android:orientation="vertical"
        android:padding="30dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/link_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tv_import_hint"
            app:boxBackgroundColor="#101820"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/material_light_blue_300"
            app:hintTextColor="@color/material_blue_grey_100">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/link_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="top|start"
                android:inputType="textUri|textMultiLine|textNoSuggestions"
                android:maxLines="6"
                android:minLines="4"
                android:textColor="@color/material_light_blue_50"
                android:textColorHint="@color/material_blue_grey_100"
                android:textSize="18sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/tv_home_button_height"
                android:layout_weight="1"
                android:focusable="true"
                android:text="@string/tv_import_action"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/tv_primary_button_background"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clipboard_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/tv_home_button_height"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:focusable="true"
                android:text="@string/tv_import_from_clipboard"
                android:textAllCaps="false"
                android:textColor="@color/material_light_blue_50"
                app:backgroundTint="@color/tv_secondary_button_background"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/full_list_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_home_button_height"
            android:focusable="true"
            android:text="@string/tv_import_open_full_list"
            android:textAllCaps="false"
            android:textColor="@color/material_light_blue_50"
            app:backgroundTint="@color/tv_secondary_button_background"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
